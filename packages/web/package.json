{
  "name": "@visualizer-lite/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:tour": "vite -c tour/vite.config.ts",
    "build:tour": "tsc -p tour/tsconfig.json && vite build -c tour/vite.config.ts",
    "preview:tour": "vite preview -c tour/vite.config.ts",
    "record:tour": "tsx tour/scripts/record.ts",
    "export:tour-data": "tsx tour/scripts/export-demo-data.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "i18next": "^25.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^7.18.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
